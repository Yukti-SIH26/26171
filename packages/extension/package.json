{
  "name": "@sih/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome + Firefox extension: local perception, PII redaction, validated action execution",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "lint:webext": "web-ext lint --source-dir ../../dist/firefox-mv3 --output text --no-config-discovery",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@sih/core": "*",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "web-ext": "9.4.0",
    "wxt": "0.21.4"
  }
}
